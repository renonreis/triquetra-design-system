{
  "name": "triquetra",
  "private": true,
  "description": "Triquetra Design System monorepo.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@triquetra/storybook",
    "build": "turbo run build",
    "build-storybook": "turbo run build-storybook",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:visual:docker": "pnpm --filter @triquetra/storybook test:visual:docker",
    "test:visual:update": "pnpm --filter @triquetra/storybook test:visual:update",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=\"./packages/*\" && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.13"
  }
}

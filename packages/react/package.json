{
  "name": "@renonreis/triquetra",
  "version": "0.2.2",
  "description": "Triquetra Design System: design tokens and accessible React components.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renonreis/triquetra-design-system.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=22.22"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prepare": "node scripts/build-tokens.ts && node scripts/build-fonts.ts",
    "tokens:build": "node scripts/build-tokens.ts && node scripts/build-fonts.ts",
    "build": "pnpm tokens:build && pnpm build:lib && pnpm build:css",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify && cp -R src/styles/generated/tokens.css src/styles/generated/theme.css src/styles/generated/tokens.json src/styles/generated/fonts.css src/styles/generated/fonts dist/",
    "typecheck": "tsc --noEmit",
    "test": "pnpm tokens:build && vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.40.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "culori": "^4.0.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "style-dictionary": "^5.8.0",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

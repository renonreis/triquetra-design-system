{
  "primitive": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "geist": {
          "$value": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"],
          "$description": "Geist Sans (variable, SIL OFL 1.1). Shipped by the package in fonts.css."
        },
        "system": {
          "$value": ["ui-sans-serif", "system-ui", "sans-serif"]
        },
        "mono": {
          "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
        }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": {
          "$value": 400
        },
        "medium": {
          "$value": 500
        },
        "semibold": {
          "$value": 600
        },
        "bold": {
          "$value": 700
        }
      },
      "size": {
        "12": {
          "$value": {
            "value": 0.75,
            "unit": "rem"
          }
        },
        "14": {
          "$value": {
            "value": 0.875,
            "unit": "rem"
          }
        },
        "16": {
          "$value": {
            "value": 1,
            "unit": "rem"
          }
        },
        "18": {
          "$value": {
            "value": 1.125,
            "unit": "rem"
          }
        },
        "20": {
          "$value": {
            "value": 1.25,
            "unit": "rem"
          }
        },
        "24": {
          "$value": {
            "value": 1.5,
            "unit": "rem"
          }
        },
        "30": {
          "$value": {
            "value": 1.875,
            "unit": "rem"
          }
        },
        "36": {
          "$value": {
            "value": 2.25,
            "unit": "rem"
          }
        },
        "$type": "dimension"
      },
      "line-height": {
        "$type": "number",
        "tight": {
          "$value": 1.25
        },
        "snug": {
          "$value": 1.375
        },
        "normal": {
          "$value": 1.5
        }
      }
    }
  }
}
